    {
      "name": "01 - Affichage Page Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1 : Est-ce que le serveur répond (Code HTTP 200 OK) ?\r",
              "pm.test(\"L'application répond avec un statut 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Test 2 : Est-ce que la page se charge rapidement (Performance) ?\r",
              "pm.test(\"Le temps de réponse est inférieur à 800ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(800);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Récupération Données API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Convertir la réponse brute en un objet JSON manipulable\r",
              "const donnéesBibliothèque = pm.response.json();\r",
              "\r",
              "// 2. L'afficher proprement formaté dans la console\r",
              "// Le \"JSON.stringify(..., null, 2)\" permet d'avoir une indentation propre (saut de ligne)\r",
              "console.log(\"=== [DEBUG BDD] DONNÉES RÉCUPÉRÉES ===\");\r",
              "console.log(JSON.stringify(donnéesBibliothèque, null, 2));\r",
              "console.log(\"=======================================\");\r",
              "\r",
              "// 3. Tes tests de validation habituels\r",
              "pm.test(\"Connexion BDD OK - Status 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"L'API renvoie du JSON\", function () {\r",
              "    pm.response.to.be.withBody;\r",
              "    pm.response.to.be.json;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/apiBib",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "apiBib"
          ]
        }
      },
      "response": []
    }
